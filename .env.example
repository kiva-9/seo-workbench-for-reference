# 复制成 .env 后按需修改（.env 不进 Git）。环境里已经设置的同名变量优先，.env 不覆盖。
# 全部可以不设：不设就是本机单用户模式、数据在 ./data、端口 8477。

# 端口。改了之后 Google Cloud 里登记的 OAuth 回调地址也要一起改
# PORT=8477
# 监听地址；默认仅本机。容器填写 0.0.0.0，必须同时配置 PUBLIC_HOST 和 Access
# HOST=127.0.0.1
# DEPLOYMENT_SHA=完整40位Git提交SHA
# 一致性备份间隔（1～168 小时）
# BACKUP_INTERVAL_HOURS=24
# 维护模式：HTTP 返回 503，后台执行器暂停
# SPM_MAINTENANCE_MODE=false
# 部署脚本在允许数据库回退的校验阶段临时启用；保持健康检查，暂停后台及外部调用。
# DEPLOYMENT_HOLD=false

# 数据目录（放 spm.db 和 backups/）。生产环境放在代码目录之外：部署只换代码，不碰数据
# SPM_DATA_DIR=/srv/workbench-data

# 经反向代理部署到域名时填域名，加进 Host / Origin 白名单
# PUBLIC_HOST=work.example.com

# 团队模式：两个都填才启用，身份来自 Cloudflare Access
# CF_ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com
# CF_ACCESS_AUD=

# MCP 阶段开关：1=读取分析；2=日常写入；3=配置、维护和操作。
# MCP_ENABLED=false 可停用 MCP，已有站点和 API 继续正常工作。
# MCP_PHASE=1
# 启用后台同步、标题抓取和导出的执行器；隔离测试时关闭。
# MCP_BACKGROUND_ENABLED=false

# AI 见解：本地规则默认可用，真实外部调用和日调度各自需要明确启用。
AI_INSIGHTS_ENABLED=true
# AI 功能配置未保存外部调用开关时的默认值；网页保存后以管理员配置为准。
# 部署暂停会强制关闭外部调用，不能由网页开关覆盖。
AI_EXTERNAL_ENABLED=false
AI_SCHEDULE_ENABLED=false
# 仅 scripts/ai-insights-demo.cjs 使用隔离合成数据；不要在现有业务库启用。
AI_DEMO_MODE=false
# 可选兼容 Chat Completions 的服务端模型；项目还需 data_approved 和预算。
AI_MODEL_NAME=
AI_MODEL_KEY=
AI_MODEL_ENDPOINT=https://api.openai.com/v1/chat/completions
# USD / 一百万 token；费用模式必填，仅限制次数的项目可留空。
AI_MODEL_INPUT_RATE=
AI_MODEL_OUTPUT_RATE=
AI_MODEL_CALL_CEILING=0
